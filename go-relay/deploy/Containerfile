# hearth-relay-go image: distroless static (no shell, no libc, no package manager),
# non-root, and meant to run with a read-only root filesystem and no egress. Build with
# go-relay/ as the context:
#   podman build -f go-relay/deploy/Containerfile --ignorefile go-relay/deploy/Containerfile.dockerignore -t hearth-relay-go go-relay
# Pin both base images by digest when you deploy (see deploy/README.md).

FROM docker.io/library/golang:1.25-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY . .
# A static binary: pure Go (bbolt, x/text), nothing linked.
RUN go build -trimpath -ldflags="-s -w" -o /out/hearth-relay-go ./cmd/hearth-relay-go

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/hearth-relay-go /hearth-relay-go
# The only writable path. Mount a volume here; the root filesystem stays read-only.
VOLUME ["/data"]
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/hearth-relay-go", "--data", "/data", "--listen", "0.0.0.0:8080"]
